layer: application
language: typescript
project:
  title: App
  description: An application
  team: web
docker:
  scaffold:
    sourcesPhaseGlobs:
    - src/**/*
toolchains:
  typescript: {}
  default: node
tasks:
  build:
    command: vite build --base $projectTitle
    toolchains: node
