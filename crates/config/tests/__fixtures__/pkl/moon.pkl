amends "../../../../../website/static/pkl/v2/ProjectConfig.pkl"

import "../../../../../website/static/pkl/v2/ProjectDependencyConfig.pkl"

dependsOn = new Listing {
	"a"
	new ProjectDependencyConfig {
		id = "b"
		scope = "build"
		source = "implicit"
	}
}

docker {
	file {
		buildTask = "build"
		image = "node:latest"
		startTask = "start"
	}
	scaffold {
		sourcesPhaseGlobs = new Listing { "*.js" }
	}
}

env {
	["KEY"] = "value"
}

fileGroups {
	["sources"] = new Listing { "src/**/*" }
	["tests"] = new Listing {
		"/**/*.test.*"
	}
}

id = "custom-id"

language = "rust"

owners {
	customGroups {}
	defaultOwner = "owner"
	optional = true
	paths = new Listing { "dir/"; "file.txt" }
	requiredApprovals = 5
}

project {
	title = "Name"
	description = "Does something"
	owner = "team"
	channel = "#team"
	bool = true
	string = "abc"
}

stack = "frontend"

tags = new Listing { "a"; "b"; "c" }

tasks {}

toolchains {
	deno {
		version = "1.2.3"
	}
	typescript {
		includeSharedTypes = true
	}
}

layer = "library"

workspace {
	inheritedTasks {
		exclude = new Listing { "build" }
		include = new Listing { "test" }
		rename {
			["old"] = "new"
		}
	}
	mergeStrategies {
		env = "preserve"
		fileGroups = "replace"
	}
}
