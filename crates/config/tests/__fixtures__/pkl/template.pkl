amends "../../../../../website/static/pkl/v3/TemplateConfig.pkl"

import "../../../../../website/static/pkl/v3/TemplateVariableEnumValueConfig.pkl"

title = "Title"
description = "Description"
destination = "./out"
id = "template-name"
variables {
	["boolean"] = new TemplateVariableBoolean {
		defaultValue = false
		prompt = "Why?"
		required = true
	}
	["enum"] = new TemplateVariableEnum {
		multiple = true
		order = 4
		values = new Listing {
			"a"
			new TemplateVariableEnumValueConfig {
				label = "B"
				value = "b"
			}
			"c"
		}
	}
	["number"] = new TemplateVariableNumber {
		defaultValue = 123
		prompt = "Why?"
		order = 1
	}
	["string"] = new TemplateVariableString {
		defaultValue = "abc"
		internal = true
		prompt = "Why?"
	}
}
